# Windows login only (optional). Never set these on Vercel.
NAUKRI_USERNAME=
NAUKRI_PASSWORD=

# Vercel only: never copy these privileged credentials to the Windows agent.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DASHBOARD_USER_ID=
APP_ORIGIN=

# Enrollment secret: strong random shared value, used only to register new agents.
# Set on Vercel and temporarily on Windows; remove Windows copy after registration.
AGENT_ENROLLMENT_SECRET=

# Windows only: HTTPS dashboard origin; optional display name (no personal data).
AGENT_SERVER_URL=
AGENT_NAME=

# No NEXT_PUBLIC secrets are needed. Dashboard Auth uses HttpOnly server cookies.
