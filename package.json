{
  "name": "naukri",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "browser:install": "playwright-core install chromium --only-shell",
    "test:naukri-local-chrome": "node scripts/test-naukri-local-chrome.ts",
    "naukri:login": "node --env-file-if-exists=.env scripts/naukri-login.ts",
    "naukri:profile-info": "node scripts/naukri-profile-info.ts",
    "naukri:validate": "node scripts/validate-naukri-session.ts",
    "naukri:refresh-name": "node scripts/refresh-naukri-name.ts",
    "test": "node --test scripts/lib/*.test.ts tests/*.test.ts",
    "naukri:agent": "node --env-file-if-exists=.env scripts/windows-agent.ts",
    "naukri:agent:install": "powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -File scripts/setup-windows-agent.ps1",
    "naukri:agent:status": "node scripts/windows-agent-control.ts",
    "naukri:agent:stop": "node scripts/windows-agent-control.ts --stop",
    "naukri:agent:rotate": "node --env-file-if-exists=.env scripts/windows-agent.ts --rotate-secret"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@sparticuz/chromium-min": "153.0.0",
    "next": "16.3.6",
    "playwright-core": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "typescript": "^5"
  },
  "type": "module"
}
